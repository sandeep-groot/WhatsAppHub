generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  roles         UserRole[]

  @@index([status])
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  rememberMe Boolean  @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ClientDetail {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phoneNumber String   @map("phone_number")
  companyName String?  @map("company_name")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  clients     Client[]

  @@map("client_details")
}

model Client {
  id             String        @id @default(cuid())
  name           String
  wabaId         String        @unique
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  clientDetailId String?       @map("client_detail_id")
  clientDetail   ClientDetail? @relation(fields: [clientDetailId], references: [id])
  numbers        WhatsAppNumber[]
}

model WhatsAppNumber {
  id                 String           @id @default(cuid())
  clientId           String
  phoneNumber        String           @unique
  wabaId             String?
  phoneNumberId      String?          @unique
  ycloudAccountId    String?
  connectionStatus   ConnectionStatus @default(PENDING)
  lastPing           DateTime?        @db.Timestamptz(3)
  messageCount       Int              @default(0)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  messages           WhatsappMessage[]
  steps              OnboardingStep[]
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model OnboardingStep {
  id             String         @id @default(cuid())
  numberId       String
  stepNumber     Int
  status         StepStatus     @default(PENDING)
  notes          String?
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  whatsAppNumber WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@unique([numberId, stepNumber])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model WebhookEvent {
  id             String    @id @default(cuid())
  eventId        String?   @unique
  type           String
  apiVersion     String?
  payload        Json
  signatureValid Boolean   @default(false)
  processed      Boolean   @default(false)
  processedAt    DateTime? @db.Timestamptz(3)
  error          String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([type])
  @@index([processed])
  @@index([createdAt])
}

model WhatsappMessage {
  id              String           @id @default(cuid())
  numberId        String
  wamid           String?          @unique
  wabaId          String?
  fromNumber      String?
  toNumber        String?
  customerNumber  String
  customerName    String?
  direction       MessageDirection @default(INBOUND)
  messageType     String?
  messageText     String?
  status          String           @default("SENT")
  sendTime        DateTime?        @db.Timestamptz(3)
  createdOn       DateTime         @default(now()) @db.Timestamptz(3)
  whatsAppNumber  WhatsAppNumber   @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@index([numberId])
  @@index([wabaId])
  @@index([fromNumber])
  @@index([customerNumber])
  @@index([createdOn])
  @@map("whatsapp_messages")
}

model WebhookEventType {
  id          String   @id @default(cuid())
  type        String   @unique
  label       String
  category    String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([category])
  @@map("webhook_event_types")
}

model LanguageCode {
  id        String   @id @default(cuid())
  language  String
  code      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([language])
  @@map("language_codes")
}

enum RoleName {
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ConnectionStatus {
  PENDING
  IN_PROGRESS
  ACTIVE
  INACTIVE
  ERROR
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}
